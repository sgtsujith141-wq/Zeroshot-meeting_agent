# Copy to `.env` (git-ignored) and fill in real values locally. Never commit `.env`.

# ---- Organiser access (required) --------------------------------------------
# Single-organiser local-demo auth. Every mutating/approval API call must send
# `Authorization: Bearer <ORGANIZER_TOKEN>`. Use a long random value.
ORGANIZER_TOKEN=replace-with-a-long-random-string
ORGANIZER_NAME=Organiser

# ---- LLM ----------------------------------------------------------------------
# auto   -> gemini if GEMINI_API_KEY is set, else ollama if reachable, else none
# gemini | ollama | replay (replays previously recorded real responses only)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LLM_TEMPERATURE=0
LLM_SEED=7
LLM_TIMEOUT_SECONDS=600

# ---- Speech-to-text -----------------------------------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
# transcribe | translate | verbatim | translit | codemix
SARVAM_STT_MODE=codemix
SARVAM_LANGUAGE_CODE=unknown

# ---- Storage / server -----------------------------------------------------------
DATA_DIR=backend/data
MAX_UPLOAD_MB=200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_TIMEZONE=Asia/Kolkata
# Reminder worker poll interval (seconds). The worker only runs while the backend runs.
REMINDER_POLL_SECONDS=30

# ---- Optional outbound email (not sent unless configured AND approved) --------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
